{
  "mcpServers": {
    "mysql": {
      "command": "node",
      "args": [
        "./scripts/runtime.mjs",
        "mysql"
      ],
      "env_vars": [
        "MYSQL_HOST",
        "MYSQL_PORT",
        "MYSQL_DATABASE",
        "MYSQL_USER",
        "MYSQL_PASSWORD"
      ],
      "startup_timeout_sec": 120,
      "cwd": "."
    },
    "aws-mcp": {
      "command": "node",
      "args": [
        "./scripts/runtime.mjs",
        "aws"
      ],
      "env_vars": [
        "AWS_PROFILE",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_CONFIG_FILE",
        "AWS_SHARED_CREDENTIALS_FILE"
      ],
      "startup_timeout_sec": 120,
      "cwd": "."
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "bearer_token_env_var": "GITHUB_PERSONAL_ACCESS_TOKEN"
    }
  }
}
